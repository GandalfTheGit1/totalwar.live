%% Mapa de funcionalidades. Color = eje de la meta. Forma = estado.
%% Tamaño = número de dependencias. Línea continua = depende de. La meta no se dibuja como conexión: va en el color y en la etiqueta. Línea gruesa = pertenece al proyecto.
flowchart LR
    subgraph sec_equity["Equity system"]
        proy_equity(["Proyecto Equity system"])
    end
    subgraph sec_global["Global system (globo geopolítico)"]
        proy_global(["Proyecto Global system (globo geopolítico)"])
        desarrollo_industrial_ciudades["Monitor de desarrollo industrial y polos manufactureros urbanos | Cobertura de datos (empresas, mercados, países) | demanda 0/10 | 0 dep."]
        finanzas_publicas_soberanas["Monitor de finanzas públicas soberanas y salud fiscal | Cobertura de datos (empresas, mercados, países) | demanda 0/10 | 0 dep."]
        entidades_postura_vecinal["Monitor de entidades estratégicas, capacidades y postura vecinal | Fiabilidad y trazabilidad de fuentes | demanda 2.4/10 | 1 dep."]
        arbol_tecnologico_historico["Árbol tecnológico histórico por país actualizado con noticias | Fiabilidad y trazabilidad de fuentes | demanda 2.4/10 | 1 dep."]
        demografia_pais["Monitor demográfico por país | Cobertura de datos (empresas, mercados, países) | demanda 0/10 | 1 dep."]
    end
    desarrollo_industrial_ciudades ==> proy_global
    finanzas_publicas_soberanas ==> proy_global
    entidades_postura_vecinal ==> proy_global
    arbol_tecnologico_historico ==> proy_global
    demografia_pais ==> proy_global
    demografia_pais --> finanzas_publicas_soberanas
    classDef c_cobertura_S fill:#009E73,stroke:#222,color:#000,font-size:12px
    classDef c_fiabilidad_S fill:#D55E00,stroke:#222,color:#000,font-size:12px
    class desarrollo_industrial_ciudades c_cobertura_S
    class finanzas_publicas_soberanas c_cobertura_S
    class entidades_postura_vecinal c_fiabilidad_S
    class arbol_tecnologico_historico c_fiabilidad_S
    class demografia_pais c_cobertura_S
