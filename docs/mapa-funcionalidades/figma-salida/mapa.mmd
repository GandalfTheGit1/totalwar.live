%% Mapa de funcionalidades. Color = meta principal. Forma = estado.
%% Tamaño = número de dependencias. Línea continua = depende de. Línea punteada = alimenta una meta.
flowchart LR
    subgraph sec_equity["Equity system"]
        vacio_equity["Reservado: sin funcionalidades definidas"]
    end
    subgraph sec_global["Global system (globo geopolítico)"]
        desarrollo_industrial_ciudades(("Monitor de desarrollo industrial y polos manufactureros urbanos | demanda 0/10 | 0 dep."))
        finanzas_publicas_soberanas(("Monitor de finanzas públicas soberanas y salud fiscal | demanda 0/10 | 0 dep."))
        entidades_postura_vecinal(("Monitor de entidades estratégicas, capacidades y postura vecinal | demanda 2.4/10 | 1 dep."))
    end
    meta_investigacion_mercado(["Investigación de mercado"])
    meta_seguidores(["Seguidores"])
    desarrollo_industrial_ciudades -.-> meta_investigacion_mercado
    desarrollo_industrial_ciudades -.-> meta_seguidores
    finanzas_publicas_soberanas -.-> meta_seguidores
    entidades_postura_vecinal -.-> meta_investigacion_mercado
    entidades_postura_vecinal -.-> meta_seguidores
    classDef c_investigacion_mercado_S fill:#0072B2,stroke:#222,color:#000,font-size:12px
    classDef c_seguidores_S fill:#009E73,stroke:#222,color:#000,font-size:12px
    classDef m_investigacion_mercado fill:#0072B2,stroke:#222,color:#000,stroke-width:4px
    classDef m_seguidores fill:#009E73,stroke:#222,color:#000,stroke-width:4px
    class desarrollo_industrial_ciudades c_investigacion_mercado_S
    class finanzas_publicas_soberanas c_seguidores_S
    class entidades_postura_vecinal c_investigacion_mercado_S
    class meta_investigacion_mercado m_investigacion_mercado
    class meta_seguidores m_seguidores
