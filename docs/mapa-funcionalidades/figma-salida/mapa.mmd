%% Mapa de funcionalidades. Color = meta principal. Forma = estado.
%% Tamaño = número de dependencias. Línea continua = depende de. Línea punteada = alimenta una meta.
flowchart LR
    subgraph sec_equity["Equity system"]
        calibracion_brier("Calibración y backtesting causal dual | demanda 0/10 | 0 dep.")
        laboratorio_forense["Laboratorio forense contable y muro de vencimiento de deuda | demanda 0/10 | 1 dep."]
        regimen_credito_bonos["Régimen de crédito y curvas de rendimiento soberanas | demanda 0/10 | 1 dep."]
    end
    subgraph sec_global["Global system (globo geopolítico)"]
        reclamaciones_territoriales["Motor de reclamaciones territoriales y fricción bilateral | demanda 0/10 | 0 dep."]
        calibracion_relaciones_gdelt["Calibración histórica del modelo de relaciones bilaterales | demanda 0/10 | 1 dep."]
    end
    meta_sin_meta(["Sin meta definida"])
    calibracion_brier -.-> meta_sin_meta
    laboratorio_forense --> calibracion_brier
    laboratorio_forense -.-> meta_sin_meta
    regimen_credito_bonos --> calibracion_brier
    regimen_credito_bonos -.-> meta_sin_meta
    reclamaciones_territoriales -.-> meta_sin_meta
    calibracion_relaciones_gdelt --> reclamaciones_territoriales
    calibracion_relaciones_gdelt -.-> meta_sin_meta
    classDef c_sin_meta_S fill:#BDBDBD,stroke:#222,color:#000,font-size:12px
    classDef m_sin_meta fill:#BDBDBD,stroke:#222,color:#000,stroke-width:4px
    class calibracion_brier c_sin_meta_S
    class laboratorio_forense c_sin_meta_S
    class regimen_credito_bonos c_sin_meta_S
    class reclamaciones_territoriales c_sin_meta_S
    class calibracion_relaciones_gdelt c_sin_meta_S
    class meta_sin_meta m_sin_meta
